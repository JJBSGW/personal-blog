# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local tool caches (machine-specific, keep out of git)
/.cache
/.npmrc

# 上传的媒体文件(不入库,用卷持久化)
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
